{%- assign cluster = artifact.payload.cluster -%}
{%- assign user = artifact.payload.user -%}
{%- assign name = artifact.id -%}
apiVersion: v1
kind: Config
clusters:
  - name: '{{ name }}'
    cluster:
      server: '{{ cluster.server | replace: "'", "''" }}'
{%- if cluster.certificate-authority-data %}
      certificate-authority-data: '{{ cluster.certificate-authority-data }}'
{%- endif %}
{%- if cluster.tls-server-name %}
      tls-server-name: '{{ cluster.tls-server-name }}'
{%- endif %}
{%- if cluster.insecure-skip-tls-verify == true %}
      insecure-skip-tls-verify: true
{%- endif %}
{%- if cluster.proxy-url %}
      proxy-url: '{{ cluster.proxy-url | replace: "'", "''" }}'
{%- endif %}
users:
  - name: '{{ name }}'
    user:
{%- if user.token %}
      token: '{{ user.token | replace: "'", "''" }}'
{%- endif %}
{%- if user.client-certificate-data %}
      client-certificate-data: '{{ user.client-certificate-data }}'
      client-key-data: '{{ user.client-key-data }}'
{%- endif %}
{%- if user.exec %}
      exec:
        apiVersion: '{{ user.exec.apiVersion }}'
        command: '{{ user.exec.command | replace: "'", "''" }}'
{%- if user.exec.args.size > 0 %}
        args:
{%- for arg in user.exec.args %}
          - '{{ arg | replace: "'", "''" }}'
{%- endfor %}
{%- endif %}
{%- if user.exec.env.size > 0 %}
        env:
{%- for var in user.exec.env %}
          - name: '{{ var.name }}'
            value: '{{ var.value | replace: "'", "''" }}'
{%- endfor %}
{%- endif %}
        interactiveMode: '{{ user.exec.interactiveMode | default: "Never" }}'
{%- endif %}
contexts:
  - name: '{{ name }}'
    context:
      cluster: '{{ name }}'
      user: '{{ name }}'
      namespace: '{{ artifact.payload.namespace | default: "default" }}'
current-context: '{{ name }}'
preferences: {}
